<style>
.show-wrap{max-width:820px;margin:0 auto;padding:28px 24px 60px}
.show-stack{display:flex;flex-direction:column;gap:16px}

.show-topbar{display:flex;align-items:flex-start;justify-content:space-between;gap:12px;margin-bottom:20px;flex-wrap:wrap}

.status-action{display:flex;align-items:center;justify-content:space-between;gap:12px;flex-wrap:wrap;padding:14px 18px;border-bottom:1px solid var(--dan-border);background:var(--dan-surface-alt)}
.status-pills{display:flex;flex-wrap:wrap;gap:6px;align-items:center}
.action-btns{display:flex;flex-wrap:wrap;gap:6px;align-items:center}

.kategorie-label{display:flex;align-items:center;justify-content:space-between;font-size:11px;font-weight:600;text-transform:uppercase;letter-spacing:.6px;color:var(--dan-text-muted);margin-bottom:8px;padding-bottom:6px;border-bottom:1px solid var(--dan-border)}
.eintrag-item{display:flex;align-items:flex-start;justify-content:space-between;gap:10px;padding:9px 12px;background:var(--dan-surface-alt);border-radius:var(--dan-radius-sm);font-size:13.5px;margin-bottom:6px;border:1px solid transparent}
.eintrag-item:last-of-type{margin-bottom:0}
.eintrag-hrs{color:var(--dan-text-muted);font-size:12.5px;white-space:nowrap;flex-shrink:0;padding-top:1px}
.kategorie-empty{font-size:13px;color:var(--dan-text-muted);padding:6px 0}

.entry-form{margin-top:16px;padding-top:16px;border-top:1px solid var(--dan-border)}
.form-row{display:flex;gap:10px;margin-bottom:10px}
.form-row textarea,.form-row input{flex:1;min-height:60px}
.form-row input[type=number]{width:72px;flex-shrink:0;min-height:auto}

.bearbeitungs-notice{display:flex;align-items:flex-start;gap:8px;background:var(--dan-danger-bg);border:1px solid var(--dan-danger);border-radius:var(--dan-radius-sm);padding:10px 12px;font-size:12.5px;color:var(--dan-danger);margin-bottom:10px}

.total-bar{display:flex;align-items:center;justify-content:space-between;padding:14px 18px;background:var(--dan-surface-alt);border-top:1px solid var(--dan-border)}
.total-label{font-size:13px;color:var(--dan-text-muted)}
.total-value{font-size:20px;font-weight:700;color:var(--dan-text)}
</style>

<div class="show-wrap">
<div class="show-stack">

    
    <div class="show-topbar">
        <div>
            <div class="dan-page-title">
                Wochenbericht KW <%= bericht.startdatum.format('W') %> / <%= bericht.startdatum.format('Y') %>
            </div>
            <div class="dan-page-subtitle">
                <%= bericht.startdatum.format('d.m.Y') %> – <%= bericht.enddatum.format('d.m.Y') %>
            </div>
        </div>
        <div style="display:flex;gap:8px;flex-wrap:wrap">
            <a href="<%= route('wochenbericht.zeitraeume') %>" class="btn btn-secondary">
                <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><rect x="3" y="4" width="18" height="18" rx="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
                Zeiträume
            </a>
            <a href="<%= route('wochenbericht.index') %>" class="btn btn-secondary">
                <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><polyline points="15 18 9 12 15 6"/></svg>
                Alle Berichte
            </a>
        </div>
    </div>

    <% if (session('success')) { %>
        <div class="dan-alert success">
            <div class="dan-alert-icon"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><polyline points="20 6 9 17 4 12"/></svg></div>
            <div class="dan-alert-title" style="font-weight:500"><%= session('success') %></div>
        </div>
    <% } %>
    <% if (session('error')) { %>
        <div class="dan-alert danger">
            <div class="dan-alert-icon"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg></div>
            <div class="dan-alert-title" style="font-weight:500"><%= session('error') %></div>
        </div>
    <% } %>

    
    <% if (zeitraum) { %>
        <div class="card" style="border-color:var(--dan-primary-100);background:var(--dan-info-bg)">
            <div style="padding:14px 18px;display:flex;align-items:flex-start;gap:10px">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="var(--dan-info)" stroke-width="2" stroke-linecap="round" style="flex-shrink:0;margin-top:1px"><rect x="3" y="4" width="18" height="18" rx="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
                <div style="font-size:13.5px;color:var(--dan-text)">
                    <% if (zeitraumVoll) { %>
                        Diese Woche fällt vollständig in den Zeitraum <strong>„<%= zeitraum.bezeichnung %>“</strong>
                        (<%= zeitraum.von_datum.format('d.m.Y') %> – <%= zeitraum.bis_datum.format('d.m.Y') %>).
                        Es werden keine regulären Einträge/Stunden erwartet.
                    <% } else { %>
                        <strong><%= zeitraumTage %></strong> dieser Woche fallen in den Zeitraum <strong>„<%= zeitraum.bezeichnung %>“</strong>
                        (<%= zeitraum.von_datum.format('d.m.Y') %> – <%= zeitraum.bis_datum.format('d.m.Y') %>).
                        Die übrigen Tage werden normal erfasst.
                    <% } %>
                </div>
            </div>
        </div>
    <% } %>

    
    <div class="card">
        <div class="status-action">
            <div class="status-pills">
                <% if (bericht.gesperrt) { %>
                    <span class="pill pill-locked">🔒 Gesperrt</span>
                <% } else if (bericht.azubi_signiert) { %>
                    <span class="pill pill-success">✓ Signiert</span>
                <% } else if (bericht.abgegeben) { %>
                    <span class="pill pill-warning">↑ Abgegeben</span>
                <% } else { %>
                    <span class="pill pill-neutral">✏ In Bearbeitung</span>
                <% } %>
                <% if (bericht.bearbeitet) { %>
                    <span class="pill pill-danger">⚠ Nachträglich bearbeitet</span>
                <% } %>
            </div>
            <% if (!bericht.gesperrt) { %>
                <div class="action-btns">
                    <% if (!bericht.abgegeben) { %>
                        <form method="POST" action="<%= route('wochenbericht.abgeben', bericht.id) %>">
                            
                            <button class="btn btn-warning">
                                <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><line x1="22" y1="2" x2="11" y2="13"/><polygon points="22 2 15 22 11 13 2 9 22 2"/></svg>
                                Abgeben
                            </button>
                        </form>
                    <% } %>
                    <% if (bericht.abgegeben && !bericht.azubi_signiert) { %>
                        <form method="POST" action="<%= route('wochenbericht.signieren', bericht.id) %>">
                            
                            <button class="btn btn-success">✍ Selbst signieren</button>
                        </form>
                    <% } %>
                    <a href="<%= route('wochenbericht.pdf', bericht.id) %>" class="btn btn-secondary">
                        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/></svg>
                        PDF
                    </a>
                </div>
            <% } else { %>
                <a href="<%= route('wochenbericht.pdf', bericht.id) %>" class="btn btn-secondary">
                    <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/></svg>
                    PDF exportieren
                </a>
            <% } %>
        </div>

        
        <% if (!bericht.gesperrt && bericht.abgegeben) { %>
            <div style="padding:16px 18px;border-top:1px solid var(--dan-border)">
                <div class="bearbeitungs-notice">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" style="flex-shrink:0;margin-top:1px"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
                    <div>Nachträgliche Bearbeitung — Pflichtkommentar erforderlich. Gilt für alle neuen Einträge.</div>
                </div>
                <form method="POST" action="<%= route('wochenbericht.bearbeitung.speichern', bericht.id) %>">
                    
                    <textarea id="global-bearbeitungs-kommentar"
                        name="bearbeitungs_kommentar"
                        placeholder="Was wurde nachträglich geändert / ergänzt?"
                        class="dan-textarea"
                        style="border-color:var(--dan-danger);min-height:56px;margin-bottom:10px"
                        oninput="syncKommentar(this.value)"
                        maxlength="500"
                        required><%= old('bearbeitungs_kommentar') %></textarea>
                    <% if (errors['bearbeitungs_kommentar']) { const message = errors['bearbeitungs_kommentar']; %>
                        <div style="color:var(--dan-danger);font-size:12px;margin:-6px 0 10px"><%= message %></div>
                    <% } %>
                    <button type="submit" class="btn btn-danger" style="font-size:12.5px;padding:7px 13px">
                        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M19 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11l5 5v11a2 2 0 0 1-2 2z"/><polyline points="17 21 17 13 7 13 7 21"/><polyline points="7 3 7 8 15 8"/></svg>
                        Kommentar speichern
                    </button>
                </form>
            </div>
        <% } %>

        
        <% for (const [key, info] of Object.entries({
            'betrieb': {'label': 'Betriebliche Tätigkeiten', 'icon': '<path d="M20 7H4a2 2 0 0 0-2 2v10a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2V9a2 2 0 0 0-2-2z"/><path d="M16 7V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v2"/>'},
            'unterweisung': {'label': 'Unterweisungen / Schulungen', 'icon': '<path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"/><path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"/>'},
            'berufsschule': {'label': 'Themen des Berufsschulunterrichts', 'icon': '<path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/>'},
        })) { %>
            <% const kat = eintraege.get(key, collect());
                const summe = kat.sum('stunden'); %>
            <div class="card-body" style="border-top:1px solid var(--dan-border)">
                <div class="kategorie-label">
                    <span style="display:flex;align-items:center;gap:7px">
                        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><%- info['icon'] %></svg>
                        <%= info['label'] %>
                    </span>
                    <% if (!zeitraumVoll && summe > 0) { %>
                        <span style="font-size:12px;font-weight:600;color:var(--dan-text-muted)"><%= summe %> Std gesamt</span>
                    <% } %>
                </div>

                <% if (zeitraumVoll) { %>
                    <div class="eintrag-item" style="background:var(--dan-info-bg);color:var(--dan-info);font-weight:500">
                        <span><%= zeitraum.bezeichnung %></span>
                    </div>
                <% } else if (kat.count()) { %>
                    <% for (const eintrag of iter(kat)) { %>
                        <div class="eintrag-item">
                            <span><%= eintrag.beschreibung %></span>
                            <span class="eintrag-hrs"><%= eintrag.stunden %> Std</span>
                        </div>
                    <% } %>
                <% } else { %>
                    <div class="kategorie-empty">Noch keine Einträge.</div>
                <% } %>

                
                <% if (!bericht.gesperrt && !zeitraumVoll) { %>
                    <div class="entry-form">
                        <form method="POST" action="<%= route('wochenbericht.speichern', bericht.id) %>">
                            
                            <input type="hidden" name="kategorie" value="<%= key %>">
                            <% if (bericht.abgegeben) { %>
                                <input type="hidden" name="bearbeitungs_kommentar" class="kommentar-sync" value="">
                            <% } %>
                            <div class="form-row">
                                <textarea name="beschreibung" placeholder="Was wurde gemacht?" class="dan-textarea" required><%= old('beschreibung') %></textarea>
                                <input type="number" name="stunden" step="0.5" min="0" max="99" placeholder="Std" class="dan-input" value="<%= old('stunden') %>" required>
                            </div>
                            <% if (errors['beschreibung']) { const message = errors['beschreibung']; %>
                                <div style="color:var(--dan-danger);font-size:12px;margin-top:4px"><%= message %></div>
                            <% } %>
                            <% if (errors['stunden']) { const message = errors['stunden']; %>
                                <div style="color:var(--dan-danger);font-size:12px;margin-top:4px"><%= message %></div>
                            <% } %>
                            <button type="submit" class="btn btn-primary" style="font-size:12.5px;padding:7px 13px">
                                <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
                                Eintrag hinzufügen
                            </button>
                        </form>
                    </div>
                <% } %>
            </div>
        <% } %>

        
        <div class="total-bar">
            <span class="total-label">Gesamtstunden diese Woche</span>
            <span class="total-value"><%= zeitraumVoll ? 0 : bericht.gesamtstunden() %> Std</span>
        </div>
    </div>

    
    <% if (kommentare.count()) { %>
        <div class="card">
            <div class="card-header bordered">
                <span class="card-title">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>
                    Kommentare
                </span>
                <span class="pill pill-primary"><%= kommentare.count() %></span>
            </div>
            <div class="card-body">
                <% for (const k of iter(kommentare)) { %>
                    <div class="comment-item">
                        <div class="comment-meta"><%= k.autor.full_name %> · <%= k.created_at.format('d.m.Y H:i') %></div>
                        <div class="comment-text"><%= k.inhalt %></div>
                    </div>
                <% } %>
            </div>
        </div>
    <% } %>

    
    <% if (bearbeitungen.count()) { %>
        <div class="card">
            <div class="card-header bordered">
                <span class="card-title">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 8 14"/></svg>
                    Bearbeitungshistorie
                </span>
                <span class="pill pill-danger"><%= bearbeitungen.count() %></span>
            </div>
            <div class="card-body">
                <% for (const b of iter(bearbeitungen)) { %>
                    <div class="history-item">
                        <div class="history-meta"><%= b.created_at.format('d.m.Y H:i') %></div>
                        <div class="history-text"><%= b.kommentar %></div>
                    </div>
                <% } %>
            </div>
        </div>
    <% } %>

</div>
</div>
<script>
function syncKommentar(val) {
    document.querySelectorAll('.kommentar-sync').forEach(input => input.value = val);
}
</script>
