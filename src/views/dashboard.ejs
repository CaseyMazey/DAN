<div class="dan-content">

    
    <div class="dan-page-header">
        <div>
            <div class="dan-page-title">Hallo, <%= user.vorname %> 👋</div>
            <div class="dan-page-subtitle"><%= now().format('l, d. F Y') %></div>
        </div>
        <% if (user.ausbildungsbeginn && user.ausbildungsende) { %>
            <% const start = user.ausbildungsbeginn;
                const end   = user.ausbildungsende;
                const total = Math.trunc(start.diffInWeeks(end));
                const done  = Math.trunc(start.diffInWeeks(now()));
                const pct   = min(100, round(done / max(1,total) * 100)); %>
            <div style="display:flex;align-items:center;gap:10px;flex-shrink:0">
                <div style="font-size:12px;color:var(--dan-text-muted);text-align:right">
                    Ausbildung<br><strong style="color:var(--dan-text)"><%= done %> / <%= total %> Wochen</strong>
                </div>
                <div class="dan-progress-track" style="width:90px">
                    <div class="dan-progress-fill" style="width:<%= pct %>%"></div>
                </div>
                <div style="font-size:12px;font-weight:600;color:var(--dan-primary-700)"><%= pct %>%</div>
            </div>
        <% } %>
    </div>

    
    <% if (nichtSigniert > 0) { %>
        <div class="dan-alert warning">
            <div class="dan-alert-icon">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M12 19l7-7 3 3-7 7-3-3z"/><path d="M18 13l-1.5-7.5L2 2l3.5 14.5L13 18l5-5z"/><path d="M2 2l7.586 7.586"/><circle cx="11" cy="11" r="2"/></svg>
            </div>
            <div>
                <div class="dan-alert-title"><%= nichtSigniert %> Bericht<%= nichtSigniert > 1 ? 'e' : '' %> warten auf deine Signatur</div>
                <div class="dan-alert-sub"><a href="<%= route('wochenbericht.index') %>" style="color:var(--dan-warning)">Jetzt signieren →</a></div>
            </div>
        </div>
    <% } %>

    
    <div>
        <div class="dan-section-label">
            <span class="dan-eyebrow">Wochenberichte</span>
            <a href="<%= route('wochenbericht.index') %>" class="card-link">Alle anzeigen →</a>
        </div>
        <div class="dan-grid dan-grid-4">
            <div class="stat-card">
                <div class="stat-icon" style="background:var(--dan-surface-alt)">
                    <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="var(--dan-text-muted)" stroke-width="2" stroke-linecap="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/></svg>
                </div>
                <div class="stat-number"><%= berichtStats['gesamt'] %></div>
                <div class="stat-label">Berichte gesamt</div>
            </div>
            <div class="stat-card">
                <div class="stat-icon" style="background:var(--dan-success-bg)">
                    <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="var(--dan-success)" stroke-width="2" stroke-linecap="round"><polyline points="20 6 9 17 4 12"/></svg>
                </div>
                <div class="stat-number" style="color:var(--dan-success)"><%= berichtStats['signiert'] %></div>
                <div class="stat-label">Signiert</div>
            </div>
            <div class="stat-card">
                <div class="stat-icon" style="background:var(--dan-warning-bg)">
                    <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="var(--dan-warning)" stroke-width="2" stroke-linecap="round"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
                </div>
                <div class="stat-number" style="color:var(--dan-warning)"><%= berichtStats['ausstehend'] %></div>
                <div class="stat-label">Noch zu signieren</div>
            </div>
            <div class="stat-card">
                <div class="stat-icon" style="background:var(--dan-danger-bg)">
                    <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="var(--dan-danger)" stroke-width="2" stroke-linecap="round"><path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"/><line x1="12" y1="9" x2="12" y2="13"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg>
                </div>
                <div class="stat-number" style="color:var(--dan-danger)"><%= berichtStats['bearbeitet'] %></div>
                <div class="stat-label">Nachträglich bearbeitet</div>
            </div>
        </div>
    </div>

    
    <div class="dan-grid dan-grid-3">

        
        <div class="card">
            <div class="card-header">
                <span class="card-title">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><polyline points="9 11 12 14 22 4"/><path d="M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11"/></svg>
                    Aufgaben
                </span>
                <a href="<%= route('aufgaben.index') %>" class="card-link">Alle anzeigen →</a>
            </div>
            <div class="card-body">
                <div class="list-row">
                    <div class="list-row-left">
                        <div class="list-row-icon" style="background:var(--dan-surface-alt);color:var(--dan-text-muted)">
                            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><rect x="3" y="4" width="18" height="18" rx="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
                        </div>
                        <div class="list-row-title">Geplant</div>
                    </div>
                    <div class="list-row-value"><%= aufgabenStats['geplant'] %></div>
                </div>
                <div class="list-row">
                    <div class="list-row-left">
                        <div class="list-row-icon" style="background:var(--dan-info-bg);color:var(--dan-info)">
                            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="12" cy="12" r="9"/><polyline points="12 6 12 12 16 14"/></svg>
                        </div>
                        <div class="list-row-title">In Bearbeitung</div>
                    </div>
                    <div class="list-row-value" style="color:var(--dan-info)"><%= aufgabenStats['in_bearbeitung'] %></div>
                </div>
                <div class="list-row">
                    <div class="list-row-left">
                        <div class="list-row-icon" style="background:var(--dan-success-bg);color:var(--dan-success)">
                            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><polyline points="20 6 9 17 4 12"/></svg>
                        </div>
                        <div class="list-row-title">Fertig</div>
                    </div>
                    <div class="list-row-value" style="color:var(--dan-success)"><%= aufgabenStats['fertig'] %></div>
                </div>
            </div>
        </div>

        
        <div class="card">
            <div class="card-header">
                <span class="card-title">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
                    Diese Woche
                </span>
            </div>
            <div class="card-body">
                <div style="display:flex;align-items:baseline;gap:6px">
                    <span style="font-size:32px;font-weight:700;letter-spacing:-1px;color:var(--dan-text)"><%= stundenDieseWoche %></span>
                    <span style="font-size:13px;color:var(--dan-text-muted)">Std.</span>
                </div>
                <div style="font-size:12px;color:var(--dan-text-muted);margin-bottom:12px">Aktive Aufgaben</div>
                <div class="dan-progress-track" style="margin-bottom:14px">
                    <div class="dan-progress-fill" style="width:<%= (aufgabenStats['in_bearbeitung'] + aufgabenStats['fertig']) > 0 ? min(100, round(aufgabenStats['fertig'] / max(1, aufgabenStats['in_bearbeitung'] + aufgabenStats['fertig']) * 100)) : 0 %>%"></div>
                </div>
                <div class="list-row" style="padding:6px 0">
                    <div class="list-row-title" style="font-weight:400"><%= aufgabenStats['in_bearbeitung'] %> Aufgaben in Bearbeitung</div>
                </div>
                <div class="list-row" style="padding:6px 0">
                    <div class="list-row-title" style="font-weight:400"><%= aufgabenStats['fertig'] %> Fertiggestellte Aufgaben</div>
                </div>
            </div>
        </div>

        
        <div class="card">
            <div class="card-header">
                <span class="card-title">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><rect x="3" y="4" width="18" height="18" rx="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
                    Nächste Termine
                </span>
                <a href="<%= route('kalender.index') %>" class="card-link">Alle →</a>
            </div>
            <div class="card-body">
                <% if (count(naechsteTermine)) { for (const termin of iter(naechsteTermine)) { %>
                    <div class="list-row">
                        <div>
                            <div class="list-row-title"><%= termin.fach %></div>
                            <div class="list-row-sub"><%= ucfirst(termin.typ) %><% if (termin.thema) { %> — <%= termin.thema %><% } %></div>
                        </div>
                        <div style="text-align:right">
                            <div style="font-size:12.5px;font-weight:500;color:var(--dan-text)"><%= termin.datum.format('d.m.Y') %></div>
                            <div style="font-size:11.5px;color:var(--dan-text-muted)"><%= termin.datum.diffForHumans() %></div>
                        </div>
                    </div>
                <% } } else { %>
                    <div class="empty-state">Keine kommenden Termine.</div>
                <% } %>
            </div>
        </div>
    </div>

</div>
