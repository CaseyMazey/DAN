<x-slot name="header">
    <div class="dan-page-title">Mein Profil</div>
</x-slot>

<style>
        .profil-page {
            display: grid;
            grid-template-columns: 220px 1fr;
            gap: 0;
            max-width: 1180px;
            margin: 0 auto;
            min-height: calc(100vh - 65px);
        }

        /* ─── Left subnav ─── */
        .profil-subnav {
            background: var(--dan-surface);
            border-right: 1px solid var(--dan-border);
            padding: 20px 10px;
            display: flex;
            flex-direction: column;
            gap: 2px;
            position: sticky;
            top: var(--dan-header-h);
            max-height: calc(100vh - var(--dan-header-h));
            overflow-y: auto;
            align-self: start;
        }
        .profil-subnav-section {
            font-size: 10px;
            font-weight: 600;
            text-transform: uppercase;
            letter-spacing: .7px;
            color: var(--dan-text-muted);
            padding: 10px 8px 4px;
            opacity: .75;
        }
        .profil-subnav-item {
            display: flex;
            align-items: center;
            gap: 8px;
            padding: 7px 10px;
            border-radius: var(--dan-radius-sm);
            font-size: 13.5px;
            color: var(--dan-text-muted);
            text-decoration: none;
            transition: all .15s;
            position: relative;
            border: none;
            background: none;
            cursor: pointer;
            font-family: inherit;
            width: 100%;
        }
        .profil-subnav-item:hover {
            background: var(--dan-surface-alt);
            color: var(--dan-text);
        }
        .profil-subnav-item.active {
            background: var(--dan-primary-100);
            color: var(--dan-primary-700);
            font-weight: 500;
        }
        .profil-subnav-item.active::before {
            content: '';
            position: absolute;
            left: 0; top: 4px; bottom: 4px;
            width: 3px;
            border-radius: 0 3px 3px 0;
            background: var(--dan-primary-700);
        }

        /* ─── Content area ─── */
        .profil-content {
            padding: 28px 32px;
            display: flex;
            flex-direction: column;
            gap: 20px;
            max-width: 760px;
        }

        /* ─── Page heading ─── */
        .profil-heading {
            display: flex;
            align-items: center;
            gap: 14px;
            margin-bottom: 4px;
        }
        .profil-heading-avatar {
            width: 50px; height: 50px;
            border-radius: 50%;
            background: linear-gradient(135deg, var(--dan-primary-700) 0%, var(--dan-primary-400) 100%);
            color: #fff;
            font-size: 17px;
            font-weight: 600;
            display: flex;
            align-items: center;
            justify-content: center;
            flex-shrink: 0;
            letter-spacing: .5px;
        }
        .profil-heading h1 {
            font-size: 20px;
            font-weight: 600;
            color: var(--dan-text);
            margin: 0;
        }
        .profil-heading p {
            font-size: 13px;
            color: var(--dan-text-muted);
            margin: 2px 0 0;
        }
        .profil-heading p span {
            color: var(--dan-primary-700);
            font-weight: 500;
        }

        /* ─── Section cards ─── */
        .profil-card { scroll-margin-top: 80px; }
        .profil-card-header {
            padding: 16px 20px;
            border-bottom: 1px solid var(--dan-border);
            display: flex;
            align-items: center;
            gap: 12px;
        }
        .profil-card-icon {
            width: 32px; height: 32px;
            border-radius: 7px;
            background: var(--dan-primary-100);
            display: flex;
            align-items: center;
            justify-content: center;
            flex-shrink: 0;
        }
        .profil-card-icon svg { display: block; }
        .profil-card-header-text h2 {
            font-size: 14px;
            font-weight: 600;
            color: var(--dan-text);
            margin: 0;
        }
        .profil-card-header-text p {
            font-size: 12px;
            color: var(--dan-text-muted);
            margin: 2px 0 0;
        }
        .profil-card-body {
            padding: 20px;
            display: flex;
            flex-direction: column;
            gap: 16px;
        }

        input[readonly] { background: var(--dan-surface-alt); color: var(--dan-text-muted); cursor: default; }
        input[type="date"] { color-scheme: light; }
        html[data-theme="dark"] input[type="date"] { color-scheme: dark; }

        /* ─── Password strength ─── */
        .profil-pw-strength { display: flex; gap: 4px; margin-top: 4px; }
        .profil-pw-bar { flex: 1; height: 3px; border-radius: 99px; background: var(--dan-border); transition: background .2s; }
        .profil-pw-bar.ok   { background: var(--dan-success); }
        .profil-pw-bar.warn { background: var(--dan-warning); }

        /* ─── Divider ─── */
        .profil-divider {
            display: flex;
            align-items: center;
            gap: 12px;
            color: var(--dan-text-muted);
            font-size: 11px;
            text-transform: uppercase;
            letter-spacing: .5px;
        }
        .profil-divider::before,
        .profil-divider::after {
            content: '';
            flex: 1;
            height: 1px;
            background: var(--dan-border);
        }

        /* ─── Signature ─── */
        .profil-sig-current {
            border: 1px solid var(--dan-border);
            border-radius: var(--dan-radius-sm);
            background: var(--dan-surface-alt);
            padding: 16px;
            display: flex;
            align-items: center;
            justify-content: center;
            min-height: 90px;
        }
        .profil-sig-current img { max-height: 70px; max-width: 100%; }
        .profil-sig-no-sig { color: var(--dan-text-muted); font-size: 13px; }
        .profil-sig-tabs {
            display: flex;
            border: 1px solid var(--dan-border);
            border-radius: var(--dan-radius-sm);
            overflow: hidden;
            width: fit-content;
        }
        .profil-sig-tab {
            padding: 6px 16px;
            font-size: 12.5px;
            font-weight: 500;
            background: transparent;
            color: var(--dan-text-muted);
            border: none;
            cursor: pointer;
            font-family: var(--dan-font);
            transition: all .15s;
        }
        .profil-sig-tab + .profil-sig-tab { border-left: 1px solid var(--dan-border); }
        .profil-sig-tab.active { background: var(--dan-primary-100); color: var(--dan-primary-700); }
        .profil-sig-canvas-wrap {
            border: 1.5px dashed var(--dan-border-strong);
            border-radius: var(--dan-radius-sm);
            background: var(--dan-surface-alt);
            position: relative;
            overflow: hidden;
            cursor: crosshair;
        }
        .profil-sig-canvas-wrap canvas { display: block; width: 100%; height: 140px; touch-action: none; }
        .profil-sig-hint {
            position: absolute; inset: 0;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 12.5px;
            color: var(--dan-text-muted);
            pointer-events: none;
            transition: opacity .2s;
        }
        .profil-sig-upload-area {
            border: 1.5px dashed var(--dan-border-strong);
            border-radius: var(--dan-radius-sm);
            background: var(--dan-surface-alt);
            padding: 28px 20px;
            text-align: center;
            cursor: pointer;
            transition: border-color .15s;
        }
        .profil-sig-upload-area:hover { border-color: var(--dan-primary-500); }
        .profil-sig-upload-icon {
            width: 38px; height: 38px;
            border-radius: 8px;
            background: var(--dan-primary-100);
            margin: 0 auto 10px;
            display: flex;
            align-items: center;
            justify-content: center;
        }
        .profil-sig-upload-text { font-size: 13px; color: var(--dan-text-muted); }
        .profil-sig-upload-text strong { color: var(--dan-primary-700); font-weight: 500; }

        /* ─── Responsive ─── */
        @media (max-width: 768px) {
            .profil-page { grid-template-columns: 1fr; }
            .profil-subnav {
                position: static;
                height: auto;
                flex-direction: row;
                flex-wrap: wrap;
                border-right: none;
                border-bottom: 1px solid var(--dan-border);
            }
            .profil-subnav-section { display: none; }
            .profil-content { padding: 20px 16px; }
        }
    </style>

<div class="profil-page">

    
    <nav class="profil-subnav" aria-label="Profil-Navigation">
        <div class="profil-subnav-section">Profil</div>

        <a href="#sec-personal" class="profil-subnav-item active" data-section="sec-personal">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
            Persönliche Daten
        </a>
        <a href="#sec-sig" class="profil-subnav-item" data-section="sec-sig">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M3 17l4-8 4 4 4-6 4 10"/></svg>
            Meine Signatur
        </a>
    </nav>

    
    <main class="profil-content">

        
        <div class="profil-heading">
            <div class="profil-heading-avatar" aria-hidden="true">
                <%= strtoupper(substr(user.vorname, 0, 1)) %><%= strtoupper(substr(user.nachname, 0, 1)) %>
            </div>
            <div>
                <h1><%= user.full_name %></h1>
                <p><span><%= user.abteilung || 'Auszubildende/r' %></span></p>
            </div>
        </div>

        
        <section class="card profil-card" id="sec-personal">
            <div class="profil-card-header">
                <div class="profil-card-icon">
                    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="var(--dan-primary-700)" stroke-width="2"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
                </div>
                <div class="profil-card-header-text">
                    <h2>Persönliche Daten</h2>
                    <p>Name, Abteilung und Ausbildungszeitraum</p>
                </div>
            </div>
            <div class="profil-card-body">

                
                <% if (session('status') === 'profile-updated') { %>
                    <div class="dan-alert success">
                        <div class="dan-alert-icon"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="20 6 9 17 4 12"/></svg></div>
                        <div class="dan-alert-title" style="font-weight:500">Profil erfolgreich gespeichert.</div>
                    </div>
                <% } %>

                <% if (Object.keys(errors).length && !errors.signatur_canvas) { %>
                    <div class="dan-alert danger">
                        <div class="dan-alert-icon"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg></div>
                        <div class="dan-alert-title" style="font-weight:500"><%= Object.values(errors)[0] %></div>
                    </div>
                <% } %>

                <form method="POST" action="<%= route('profile.update') %>">
                    
                    <input type="hidden" name="_method" value="PATCH">

                    <div class="dan-grid dan-grid-2" style="margin-bottom:16px">
                        <div class="dan-field">
                            <label class="dan-label" for="vorname">Vorname</label>
                            <input type="text" id="vorname" name="vorname" class="dan-input"
                                   value="<%= old('vorname', user.vorname) %>"
                                   required autocomplete="given-name"/>
                            <% if (errors['vorname']) { const message = errors['vorname']; %>
                                <span class="error-msg" style="font-size:11px;color:var(--dan-danger)"><%= message %></span>
                            <% } %>
                        </div>
                        <div class="dan-field">
                            <label class="dan-label" for="nachname">Nachname</label>
                            <input type="text" id="nachname" name="nachname" class="dan-input"
                                   value="<%= old('nachname', user.nachname) %>"
                                   required autocomplete="family-name"/>
                            <% if (errors['nachname']) { const message = errors['nachname']; %>
                                <span class="error-msg" style="font-size:11px;color:var(--dan-danger)"><%= message %></span>
                            <% } %>
                        </div>
                    </div>


                        <div class="dan-grid dan-grid-2" style="margin-bottom:16px">
                            <div class="dan-field">
                                <label class="dan-label" for="ausbildungsbeginn">Ausbildungsbeginn</label>
                                <input type="date" id="ausbildungsbeginn" name="ausbildungsbeginn" class="dan-input"
                                       value="<%= old('ausbildungsbeginn', user.ausbildungsbeginn?.format('Y-m-d')) %>"/>
                                <% if (errors['ausbildungsbeginn']) { const message = errors['ausbildungsbeginn']; %>
                                    <span class="error-msg" style="font-size:11px;color:var(--dan-danger)"><%= message %></span>
                                <% } %>
                            </div>
                            <div class="dan-field">
                                <label class="dan-label" for="ausbildungsende">Ausbildungsende</label>
                                <input type="date" id="ausbildungsende" name="ausbildungsende" class="dan-input"
                                       value="<%= old('ausbildungsende', user.ausbildungsende?.format('Y-m-d')) %>"/>
                                <% if (errors['ausbildungsende']) { const message = errors['ausbildungsende']; %>
                                    <span class="error-msg" style="font-size:11px;color:var(--dan-danger)"><%= message %></span>
                                <% } %>
                            </div>
                        </div>

                        <div class="dan-field" style="margin-bottom:16px">
                            <label class="dan-label" for="abteilung">Ausbildende Abteilung <span style="font-weight:400;color:var(--dan-text-muted)">(optional, erscheint auf dem IHK-Nachweis)</span></label>
                            <input type="text" id="abteilung" name="abteilung" class="dan-input"
                                   value="<%= old('abteilung', user.abteilung ?? '') %>" maxlength="255"/>
                            <% if (errors['abteilung']) { const message = errors['abteilung']; %>
                                <span class="error-msg" style="font-size:11px;color:var(--dan-danger)"><%= message %></span>
                            <% } %>
                        </div>

                    <div style="display:flex;justify-content:flex-end;padding-top:4px">
                        <button type="submit" class="btn btn-primary">
                            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="20 6 9 17 4 12"/></svg>
                            Speichern
                        </button>
                    </div>
                </form>
            </div>
        </section>

        

        
        <section class="card profil-card" id="sec-sig">
            <div class="profil-card-header">
                <div class="profil-card-icon">
                    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="var(--dan-primary-700)" stroke-width="2"><path d="M3 17l4-8 4 4 4-6 4 10"/></svg>
                </div>
                <div class="profil-card-header-text">
                    <h2>Meine Signatur</h2>
                    <p>Wird auf Wochenberichten angezeigt</p>
                </div>
            </div>
            <div class="profil-card-body">

                
                <div>
                    <div style="font-size:12px;font-weight:500;color:var(--dan-text-muted);margin-bottom:8px">Aktuelle Signatur</div>
                    <div class="profil-sig-current">
                        <% if (user.signatur_pfad) { %>
                            <img src="<%= route('profile.signatur.bild') %>?v=<%= encodeURIComponent(user.signatur_pfad) %>"
                                 alt="Deine Signatur"/>
                        <% } else { %>
                            <span class="profil-sig-no-sig">Noch keine Signatur hinterlegt</span>
                        <% } %>
                    </div>
                </div>

                <div class="profil-divider">Signatur aktualisieren</div>

                
                <div class="profil-sig-tabs" role="tablist">
                    <button class="profil-sig-tab active" role="tab" id="tab-draw-btn"
                            onclick="danSwitchSigTab('draw', this)">
                        Zeichnen
                    </button>
                    <button class="profil-sig-tab" role="tab" id="tab-upload-btn"
                            onclick="danSwitchSigTab('upload', this)">
                        Bild hochladen
                    </button>
                </div>

                
                <div id="tab-draw" role="tabpanel">
                    <form method="POST" action="<%= route('profile.signatur') %>" id="sig-canvas-form">
                        
                        <input type="hidden" name="_method" value="PATCH">
                        <input type="hidden" name="signatur_canvas" id="sig-canvas-data"/>

                        <div class="profil-sig-canvas-wrap">
                            <canvas id="sigCanvas"></canvas>
                            <div class="profil-sig-hint" id="sigHint">Hier mit der Maus oder dem Finger unterschreiben</div>
                        </div>

                        <div style="display:flex;gap:8px;margin-top:10px">
                            <button type="button" class="btn btn-secondary btn-sm"
                                    onclick="danClearCanvas()">
                                <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 6h18M8 6V4h8v2M19 6l-1 14H6L5 6"/></svg>
                                Leeren
                            </button>
                            <button type="button" class="btn btn-primary btn-sm"
                                    onclick="danSubmitCanvas()">
                                Signatur übernehmen
                            </button>
                        </div>
                    </form>
                </div>

                
                <div id="tab-upload" role="tabpanel" style="display:none">
                    <form method="POST" action="<%= route('profile.signatur') %>" id="sig-upload-form" onsubmit="return danSubmitUpload(event)">
                        <input type="hidden" name="_method" value="PATCH">
                        <input type="hidden" name="signatur_canvas" id="sig-upload-data"/>

                        <div class="profil-sig-upload-area"
                             onclick="document.getElementById('sigFile').click()"
                             id="sigDropZone">
                            <div class="profil-sig-upload-icon">
                                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="var(--dan-primary-700)" stroke-width="2"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="17 8 12 3 7 8"/><line x1="12" y1="3" x2="12" y2="15"/></svg>
                            </div>
                            <div class="profil-sig-upload-text">
                                <strong>Klicken zum Hochladen</strong> oder Datei ablegen
                            </div>
                            <div class="profil-sig-upload-text" style="margin-top:4px;font-size:11px">
                                PNG, JPG — max. 2 MB
                            </div>
                            <div id="sigFileName" style="margin-top:8px;font-size:12px;color:var(--dan-primary-700);display:none"></div>
                        </div>

                        <input type="file" id="sigFile"
                               accept="image/png,image/jpeg,image/jpg"
                               style="display:none"
                               onchange="danSigFileChosen(this)"/>

                        <div style="margin-top:10px;display:flex;justify-content:flex-end">
                            <button type="submit" class="btn btn-primary btn-sm">
                                Signatur speichern
                            </button>
                        </div>
                    </form>
                </div>

                <% if (session('status') === 'signatur-updated') { %>
                    <div class="dan-alert success">
                        <div class="dan-alert-icon"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="20 6 9 17 4 12"/></svg></div>
                        <div class="dan-alert-title" style="font-weight:500">Signatur gespeichert.</div>
                    </div>
                <% } %>

            </div>
        </section>

    </main>
</div>

<script>

    /* ── Signature tab switcher ── */
    function danSwitchSigTab(tab, btn) {
        document.querySelectorAll('.profil-sig-tab').forEach(t => t.classList.remove('active'));
        btn.classList.add('active');
        document.getElementById('tab-draw').style.display   = tab === 'draw'   ? '' : 'none';
        document.getElementById('tab-upload').style.display = tab === 'upload' ? '' : 'none';
    }

    /* ── Signature canvas ── */
    const sigCanvas = document.getElementById('sigCanvas');
    let sigCtx = null, sigDrawing = false;

    function danInitCanvas() {
        if (!sigCanvas) return;
        const rect = sigCanvas.getBoundingClientRect();
        sigCanvas.width  = Math.round(rect.width  * window.devicePixelRatio);
        sigCanvas.height = Math.round(rect.height * window.devicePixelRatio);
        sigCtx = sigCanvas.getContext('2d');
        sigCtx.scale(window.devicePixelRatio, window.devicePixelRatio);
        sigCtx.strokeStyle = document.documentElement.getAttribute('data-theme') === 'dark'
            ? '#E6EDF3' : '#1A2233';
        sigCtx.lineWidth   = 2;
        sigCtx.lineCap     = 'round';
        sigCtx.lineJoin    = 'round';
    }

    function danGetSigPos(e) {
        const rect = sigCanvas.getBoundingClientRect();
        const src  = e.touches ? e.touches[0] : e;
        return { x: src.clientX - rect.left, y: src.clientY - rect.top };
    }

    if (sigCanvas) {
        sigCanvas.addEventListener('mousedown', e => {
            sigDrawing = true;
            document.getElementById('sigHint').style.opacity = '0';
            const p = danGetSigPos(e);
            sigCtx.beginPath(); sigCtx.moveTo(p.x, p.y);
        });
        sigCanvas.addEventListener('mousemove', e => {
            if (!sigDrawing) return;
            const p = danGetSigPos(e);
            sigCtx.lineTo(p.x, p.y); sigCtx.stroke();
        });
        sigCanvas.addEventListener('mouseup',    () => sigDrawing = false);
        sigCanvas.addEventListener('mouseleave', () => sigDrawing = false);

        // Touch support
        sigCanvas.addEventListener('touchstart', e => {
            e.preventDefault(); sigDrawing = true;
            document.getElementById('sigHint').style.opacity = '0';
            const p = danGetSigPos(e);
            sigCtx.beginPath(); sigCtx.moveTo(p.x, p.y);
        }, { passive: false });
        sigCanvas.addEventListener('touchmove', e => {
            e.preventDefault();
            if (!sigDrawing) return;
            const p = danGetSigPos(e);
            sigCtx.lineTo(p.x, p.y); sigCtx.stroke();
        }, { passive: false });
        sigCanvas.addEventListener('touchend', () => sigDrawing = false);

        window.addEventListener('load', danInitCanvas);
        window.addEventListener('resize', danInitCanvas);
    }

    function danClearCanvas() {
        if (!sigCtx || !sigCanvas) return;
        sigCtx.clearRect(0, 0, sigCanvas.width, sigCanvas.height);
        const hint = document.getElementById('sigHint');
        if (hint) hint.style.opacity = '1';
    }

    function danSubmitCanvas() {
        if (!sigCanvas) return;
        const dataURL = sigCanvas.toDataURL('image/png');
        document.getElementById('sig-canvas-data').value = dataURL;
        document.getElementById('sig-canvas-form').submit();
    }

    /* ── Hochgeladenes Bild als Data-URL uebermitteln (kein Datei-Upload noetig) ── */
    function danSubmitUpload(e) {
        const input = document.getElementById('sigFile');
        const file = input.files && input.files[0];
        if (!file) { alert('Bitte zuerst ein Bild auswählen.'); e.preventDefault(); return false; }
        if (file.size > 2 * 1024 * 1024) { alert('Das Bild ist größer als 2 MB.'); e.preventDefault(); return false; }
        e.preventDefault();
        const reader = new FileReader();
        reader.onload = () => {
            document.getElementById('sig-upload-data').value = reader.result;
            document.getElementById('sig-upload-form').submit();
        };
        reader.readAsDataURL(file);
        return false;
    }

    /* ── Upload file name display ── */
    function danSigFileChosen(input) {
        const label = document.getElementById('sigFileName');
        if (!label) return;
        if (input.files && input.files[0]) {
            label.textContent = input.files[0].name;
            label.style.display = 'block';
        }
    }

    /* ── Subnav active state on scroll ── */
    const danSections = ['sec-personal','sec-sig'];
    const danNavItems = document.querySelectorAll('.profil-subnav-item[data-section]');

    function danUpdateNav() {
        let current = danSections[0];
        danSections.forEach(id => {
            const el = document.getElementById(id);
            if (el && el.getBoundingClientRect().top < 120) current = id;
        });
        danNavItems.forEach(item => {
            item.classList.toggle('active', item.dataset.section === current);
        });
    }

    window.addEventListener('scroll', danUpdateNav, { passive: true });

    /* Smooth scroll for subnav links */
    danNavItems.forEach(item => {
        item.addEventListener('click', e => {
            e.preventDefault();
            const target = document.getElementById(item.dataset.section);
            if (target) target.scrollIntoView({ behavior: 'smooth', block: 'start' });
        });
    });
</script>
