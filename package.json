{
  "name": "dan-app",
  "productName": "DAN",
  "version": "1.4.0",
  "private": true,
  "description": "DAN - Digitaler Ausbildungsnachweis als lokale Desktop-App",
  "desktopName": "dan.desktop",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "test": "node --test --no-warnings test/*.test.js",
    "dist": "electron-builder --publish never",
    "pack": "electron-builder --win dir --publish never",
    "dist:win": "electron-builder --win nsis --publish never",
    "dist:mac": "electron-builder --mac dmg zip --x64 --arm64 --publish never",
    "dist:linux": "electron-builder --linux AppImage deb --x64 --publish never"
  },
  "author": {
    "name": "CaseyMazey",
    "email": "253219934+CaseyMazey@users.noreply.github.com"
  },
  "build": {
    "appId": "de.dan.ausbildungsnachweis",
    "productName": "DAN",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "src/**/*",
      "package.json"
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.png",
      "artifactName": "DAN-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "shortcutName": "DAN",
      "deleteAppDataOnUninstall": false,
      "artifactName": "DAN-Setup-${version}.${ext}"
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "icon": "build/icon.png",
      "category": "public.app-category.education",
      "identity": "-",
      "hardenedRuntime": false,
      "gatekeeperAssess": false,
      "artifactName": "DAN-mac-${arch}-${version}.${ext}"
    },
    "dmg": {
      "title": "DAN",
      "artifactName": "DAN-mac-${arch}-${version}.${ext}"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "icon": "build/icon.png",
      "category": "Education",
      "executableName": "dan",
      "synopsis": "Digitaler Ausbildungsnachweis",
      "description": "DAN – Digitaler Ausbildungsnachweis: Wochenberichte, Aufgaben, Noten und IHK-PDF, lokal ohne Server.",
      "artifactName": "DAN-linux-${arch}-${version}.${ext}",
      "syncDesktopName": true
    },
    "deb": {
      "packageName": "dan-ausbildungsnachweis",
      "depends": [
        "libgtk-3-0t64 | libgtk-3-0",
        "libnotify4",
        "libnss3",
        "libxss1",
        "libxtst6",
        "xdg-utils",
        "libatspi2.0-0t64 | libatspi2.0-0",
        "libuuid1",
        "libsecret-1-0",
        "libgbm1",
        "libasound2t64 | libasound2"
      ]
    },
    "publish": [
      {
        "provider": "github",
        "owner": "CaseyMazey",
        "repo": "DAN",
        "releaseType": "release"
      }
    ]
  },
  "dependencies": {
    "ejs": "^3.1.10",
    "electron-updater": "^6.8.11",
    "express": "^4.22.3",
    "pdf-lib": "^1.17.1"
  },
  "devDependencies": {
    "electron": "^45.3.1",
    "electron-builder": "^26.18.0",
    "mysql2": "^3.24.6"
  },
  "homepage": "https://github.com/CaseyMazey/DAN",
  "license": "UNLICENSED"
}
