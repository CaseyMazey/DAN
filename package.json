{
  "name": "dan-app",
  "productName": "DAN",
  "version": "1.0.0",
  "private": true,
  "description": "DAN - Digitaler Ausbildungsnachweis als lokale Desktop-App",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "test": "node --test --no-warnings test/*.test.js",
    "dist": "electron-builder --win nsis --publish never",
    "pack": "electron-builder --win dir --publish never"
  },
  "author": "DAN",
  "build": {
    "appId": "de.dan.ausbildungsnachweis",
    "productName": "DAN",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "src/**/*",
      "package.json"
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "shortcutName": "DAN",
      "deleteAppDataOnUninstall": false,
      "artifactName": "DAN-Setup-${version}.${ext}"
    }
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "ejs": "^3.1.10",
    "express": "^4.22.3",
    "pdf-lib": "^1.17.1"
  },
  "devDependencies": {
    "electron": "^45.3.1",
    "electron-builder": "^26.18.0",
    "mysql2": "^3.24.6"
  }
}
